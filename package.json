{
  "name": "chess-horizon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/copy-spa-fallback.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "validate:drills": "node scripts/validate-drills.mjs",
    "test:unit": "vitest run",
    "test": "npm run validate:drills && npm run test:unit"
  },
  "dependencies": {
